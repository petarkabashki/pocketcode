"stdlib.normalize" module

[ last-tool-result "content" dict-get yaml> ] "tool-content-yaml" define
[ "title" dict-get? dup none? [ drop "untitled" ] [ ] if ] "item-title" define
[
  "items" dict-get? dup none?
  [ drop "[]" yaml> ]
  [ ]
  if
  [ item-title ]
  parallel-map
  dup "normalized.titles" shared!? drop
  ", " join
  dup "normalized.title" shared!? drop
] "normalize-item-titles" define
[
  "meta.source" get-in? dup none?
  [ drop "unknown" ]
  [ ]
  if
  dup "normalized.source" shared!? drop
  drop
] "store-normalized-source" define
[
  "items.0.enabled" get-in? dup none?
  [ drop false ]
  [ bool> ]
  if
  dup "normalized.enabled" shared!? drop
  drop
] "store-normalized-enabled" define
[
  "normalized.title" shared@ " from " concat "normalized.source" shared@ concat
  dup "normalized.summary" shared!? drop
] "store-normalized-summary" define
[
  dup ", " join
  dup "normalized.selected_actions_text" shared!? drop
] "format-selected-actions" define

"tool-content-yaml" export
"item-title" export
"normalize-item-titles" export
"store-normalized-source" export
"store-normalized-enabled" export
"store-normalized-summary" export
"format-selected-actions" export
