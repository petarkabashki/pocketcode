[ "title" dict-get? dup none? [ drop "untitled" ] [ ] if "item=" swap concat ] "label-item" define
[ "current_item" store-set "current_acc" store-set "current_acc" store-get dup empty? [ drop "current_item" store-get ] [ "; " concat "current_item" store-get concat ] if ] "append-summary" define

[
  "core.read_file"
  [
    "{path: reduce_payload.yaml}" yaml>
  ]
  [
    last-tool-result failure?
    [ "Reduce failed: missing tool payload file." answer ]
    [
      common.payload-data "payload" store-set
      "payload" store-get "items" dict-get? dup none?
      [ drop "[]" yaml> ]
      [ ]
      if
      [ label-item ]
      parallel-map
      ""
      [ append-summary ]
      reduce
      "reduced tool summary: " swap concat answer
    ]
    if
  ]
  tool-once
] "decide" define
