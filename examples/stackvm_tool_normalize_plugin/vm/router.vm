[ "title" dict-get? dup none? [ drop "untitled" ] [ ] if ] "item-title" define

[
  last-tool-result none?
  [
    "core.read_file"
    "{path: tool_payload.yaml}" yaml>
    tool-request
  ]
  [
    last-tool-result failure?
    [ "Normalization failed: missing tool payload file." answer ]
    [
      payload-data "payload" store-set

      "payload" store-get "items" dict-get? dup none?
      [ drop "[]" yaml> ]
      [ ]
      if
      [ item-title ]
      parallel-map
      dup "normalized.titles" shared!? drop
      ", " join
      dup "normalized.title" shared!? drop

      "payload" store-get "items.0.enabled" get-in? dup none?
      [ drop false ]
      [ bool> ]
      if
      dup "normalized.enabled" shared!? drop

      "payload" store-get "meta.source" get-in? dup none?
      [ drop "unknown" ]
      [ ]
      if
      dup "normalized.source" shared!? drop

      "normalized.enabled" shared@
      [
        "normalized.title" shared@ " from " concat "normalized.source" shared@ concat answer
      ]
      [
        "disabled: " "normalized.title" shared@ concat " from " concat "normalized.source" shared@ concat answer
      ]
      if
    ]
    if
  ]
  if
] "decide" define