[
  "core.read_file"
  [
    "{path: handoff_payload.yaml}" yaml>
  ]
  [
    last-tool-result failure?
    [ "stackvm_normalize_handoff_example.disabled_delegate" handoff ]
    [
      common.payload-data "payload" store-set

      "payload" store-get common.normalize-item-titles

      "payload" store-get common.store-normalized-enabled

      "payload" store-get common.store-normalized-source

      common.store-normalized-summary drop

      "normalized.enabled" shared@
      [
        True [ "stackvm_normalize_handoff_example.enabled_delegate" handoff ]
        False [ "stackvm_normalize_handoff_example.disabled_delegate" handoff ]
        "default" [ "stackvm_normalize_handoff_example.disabled_delegate" handoff ]
      ] switch
    ]
    if
  ]
  tool-once
] "decide" define
