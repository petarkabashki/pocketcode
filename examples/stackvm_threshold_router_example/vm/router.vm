[ "score" dict-get? dup none? [ drop 0 ] [ int> ] if ] "item-score" define

[
  "core.read_file"
  [
    "{path: threshold_payload.yaml}" yaml>
  ]
  [
    last-tool-result failure?
    [ "Could not load the threshold payload." answer ]
    [
      common.payload-data "payload" store-set
      "payload" store-get "items" dict-get? dup none?
      [ drop "[]" yaml> ]
      [ ]
      if
      [ item-score ]
      parallel-map
      0
      [ + ]
      reduce
      dup "normalized.total" shared!? drop

      [
        [ "normalized.total" shared@ 10 >= ] "high" "stackvm_threshold_router_example.high_route"
        [ "normalized.total" shared@ 5 >= ] "review" "stackvm_threshold_router_example.review_route"
        [ True ] "low" "stackvm_threshold_router_example.low_route"
      ]
      "normalized.band"
      handoff-rules
    ]
    if
  ]
  tool-once
] "decide" define
