"router" module
"common.normalized-config" import

[
  "route_config.yaml"
  [
    last-tool-result failure?
    [
      "tool_failure" "route_reason" "stackvm_config_router_example.fallback" shared-handoff
    ]
    [
      normalized-config
      "config_errors"
      None
      [
        [ "{enabled: true, message: $route_message, target_index: $selected_index, routes: $routes}" yaml> ]
        [
          "match.route_message" shared@ "route_message" shared!
          "match.selected_index" shared@ "selected_index" store-set
          "match.routes" shared@ "routes" store-set
          [ "routes" store-get ]
          [ "selected_index" store-get ]
          "missing_route"
          "stackvm_config_router_example.fallback"
          [ handoff ]
          indexed-handoff-route
        ]
        [ "{enabled: false, routes: $routes}" yaml> ]
        [
          "disabled" "route_reason" shared!
          [ "match.routes" shared@ ]
          [ 1 ]
          "missing_route"
          "stackvm_config_router_example.fallback"
          [ handoff ]
          indexed-handoff-route
        ]
        _
        [
          "invalid_config" "route_reason" "stackvm_config_router_example.fallback" shared-handoff
        ]
      ]
      [ drop "invalid_config" "route_reason" "stackvm_config_router_example.fallback" shared-handoff ]
      schema-route
    ]
    if
  ]
  stdlib.io.read-yaml-file-once
] "decide" define

"decide" export
