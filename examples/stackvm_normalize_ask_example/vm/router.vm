[
  "core.read_file"
  [
    "{path: ask_payload.yaml}" yaml>
  ]
  [
    last-tool-result failure?
    [ "Could not load the payload. Continue anyway?" ask-user ]
    [
      common.payload-data "payload" store-set

      "payload" store-get common.normalize-item-titles

      "payload" store-get common.store-normalized-source

      "payload" store-get common.store-normalized-enabled

      common.store-normalized-summary drop

      "normalized.enabled" shared@
      [ "Proceed with " "normalized.summary" shared@ concat "?" concat ask-user ]
      [ "Enable " "normalized.summary" shared@ concat " before continuing?" concat ask-user ]
      if
    ]
    if
  ]
  tool-once
] "decide" define
