[
  "nested_route_config.yaml"
  [
    last-tool-result failure?
    [
      "tool_failure" "route_reason" "stackvm_nested_router_example.fallback" shared-handoff
    ]
    [
      common.normalized-config
      "config_errors"
      "config"
      [
        [ "{routing: {enabled: true, selected: {index: $selected_index}, targets: $targets}}" yaml> ]
        [
          "match.selected_index" shared@ "selected_index" store-set
          "match.targets" shared@ "targets" store-set
          [ "targets" store-get ]
          [ "selected_index" store-get ]
          "missing_target"
          "stackvm_nested_router_example.fallback"
          [
            [
              [ "{agent: $selected_agent, message: $route_message}" yaml> ]
              [
                "match.route_message" shared@ "route_message" shared!
                "match.selected_agent" shared@ "selected_agent" store-set
                "config" store-get "selected" "routing.audit.status" set-in? "updated_config" store-set
                [ "selected_agent" store-get ]
                [
                  "missing_target" "route_reason" "stackvm_nested_router_example.fallback" shared-handoff
                ]
                maybe-handoff
              ]
              _
              [
                "missing_target" "route_reason" "stackvm_nested_router_example.fallback" shared-handoff
              ]
            ]
            match
          ]
          indexed-handoff-route
        ]
        [ "{routing: {enabled: false}}" yaml> ]
        [
          "disabled" "route_reason" "stackvm_nested_router_example.fallback" shared-handoff
        ]
        _
        [
          "invalid_config" "route_reason" "stackvm_nested_router_example.fallback" shared-handoff
        ]
      ]
      [ drop "invalid_config" "route_reason" "stackvm_nested_router_example.fallback" shared-handoff ]
      schema-route
    ]
    if
  ]
  stdlib.io.read-yaml-file-once
] "decide" define
