[
  "{kind: radio, prompt: placeholder, options: [{id: approve, label: Approve, value: approve}, {id: escalate, label: Escalate, value: escalate}, {id: review, label: Review, value: review}]}" yaml>
  dup "prompt" "Choose nested route for " "normalized.summary" shared@ concat dict-set
  prompt-interaction
  dup "normalized.delegate_choice" shared!? drop
  dup "approve" =
  [ drop "{decision: {route: approve, note: approved by delegate}, meta: {source: delegate}}" answer ]
  [
    dup "escalate" =
    [ drop "{decision: {route: escalate, note: escalated by delegate}, meta: {source: delegate}}" answer ]
    [ drop "{decision: {route: review}, meta: {source: delegate}}" answer ]
    if
  ]
  if
] "decide" define
