[
  last-tool-result none?
  [
    "core.read_file"
    "{path: buttons_payload.yaml}" yaml>
    tool-request
  ]
  [
    last-tool-result failure?
    [ "Could not load the payload." answer ]
    [
      payload-data "payload" store-set

      "payload" store-get normalize-item-titles

      "payload" store-get store-normalized-source

      store-normalized-summary

      "{kind: buttons, prompt: placeholder, options: [{id: approve, label: Approve, value: approve}, {id: delegate, label: Delegate, value: delegate}, {id: deny, label: Deny, value: deny}]}" yaml>
      dup "prompt" "Choose next step for " "normalized.summary" shared@ concat dict-set
      prompt-interaction
      dup "normalized.choice" shared!? drop
      [
        "approve" [ "Approved " "normalized.summary" shared@ concat answer ]
        "delegate" [ "Delegating " "normalized.summary" shared@ concat answer ]
        "default" [ "Denied " "normalized.summary" shared@ concat answer ]
      ] switch
    ]
    if
  ]
  if
] "decide" define