"common" module
"stdlib.normalize.tool-content-yaml" import
"stdlib.normalize.normalize-item-titles" "stdlib-normalize-item-titles" import
"stdlib.normalize.store-normalized-source" "stdlib-store-normalized-source" import
"stdlib.normalize.store-normalized-summary" "stdlib-store-normalized-summary" import

[ tool-content-yaml ] "payload-data" define
[ stdlib-normalize-item-titles ] "normalize-item-titles" define
[ stdlib-store-normalized-source ] "store-normalized-source" define
[ stdlib-store-normalized-summary ] "store-normalized-summary" define

"checklist-return-family"
"checklist_return_payload.yaml"
"stackvm_checklist_return_example.checklist_delegate"
[ drop "Delegate returned without an answer." answer ]
[ "Caller received delegate tools: " swap concat ]
"checklist"
"Pick tools for "
"normalized.selected_tools"
[
  "git" "Git" "git"
  "search" "Search" "search"
  "context" "Context" "context"
]
[ "min_selected" 1 ]
"contains"
[ ]
[
  "default" [ ", " join "delegate picked " swap concat " for " concat "normalized.summary" shared@ concat ]
]
define-choice-answer-family

"payload-data" export
"normalize-item-titles" export
"store-normalized-source" export
"store-normalized-summary" export
