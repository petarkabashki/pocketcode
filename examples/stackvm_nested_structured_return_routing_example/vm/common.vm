  "meta.source" "normalized.delegate_source" "unspecified"
]
[ "normalized.final_route" shared@ ]
[
  "approve" "stackvm_nested_structured_return_routing_example.approve_route"
  "escalate" "stackvm_nested_structured_return_routing_example.escalate_route"
  "default" "stackvm_nested_structured_return_routing_example.review_route"
]
"radio"
"Choose nested route for "
"normalized.delegate_choice"
[
  "approve" "Approve" "approve"
  "escalate" "Escalate" "escalate"
  "review" "Review" "review"
]
[ ]
"exact"
[ ]
[ "{}" yaml> "delegate" "meta.source" set-in ]
[
  "approve" [ "decision.route" "approve" "decision.note" "approved by delegate" ]
  "escalate" [ "decision.route" "escalate" "decision.note" "escalated by delegate" ]
  "default" [ "decision.route" "review" ]
]
define-choice-route-family

"payload-data" export
"normalize-item-titles" export
"store-normalized-source" export
