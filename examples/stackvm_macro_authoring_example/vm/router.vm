[ args later_turn ]
[ "core.read_file" [ args unquote ] [ later_turn unquote ] tool-once ]
syntax-quote "common.read-file-once" defmacro

[ body ]
[ [ body unquote-splice ] answer ]
syntax-quote "common.answer-from" defmacro

[
  [ common.macro-payload-request ]
  [
    last-tool-result failure?
    [ "Could not load macro payload." answer ]
    [
      last-tool-result "content" dict-get yaml>
      common.payload-message
      [ "Macro says: " swap concat ]
      common.answer-from
    ]
    if
  ]
  common.read-file-once
] "decide" define
