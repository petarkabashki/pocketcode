[ "title" dict-get? dup none? [ drop "untitled" ] [ ] if "item=" swap concat ] "label-item" define

[
  "core.read_file"
  [
    "{path: parallel_payload.yaml}" yaml>
  ]
  [
    last-tool-result failure?
    [ "Parallel map failed: missing tool payload file." answer ]
    [
      common.payload-data "payload" store-set
      "payload" store-get "items" dict-get? dup none?
      [ drop "[]" yaml> ]
      [ ]
      if
      [ label-item ]
      parallel-map
      ", " join
      "parallel map from tool: " swap concat answer
    ]
    if
  ]
  tool-once
] "decide" define
